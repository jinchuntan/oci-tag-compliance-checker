# Copy to .env and supply your compartment and report bucket.
# Authentication is read from the OCI SDK configuration, not this file.
OCI_COMPARTMENT_OCID=
OCI_BUCKET_NAME=
REQUIRED_TAG_KEYS=owner,environment,cost_center

# Optional settings (these match the application defaults).
OCI_PROFILE=DEFAULT
OCI_OBJECT_PREFIX=tag-compliance
